{
  "private": true,
  "description": "Local AI coding usage reports for CLI and TUI workflows",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "cargo build --release -p tokscale-cli && bun run build:cli",
    "build:cli": "bun run --cwd packages/cli build",
    "build:core": "cargo build --release -p tokscale-cli",
    "cli": "./scripts/cli.sh",
    "release:bump": "bash scripts/bump-release-version.sh",
    "test:launchers": "bash scripts/test-package-launchers.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
